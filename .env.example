# ============================================================
# CRM novo — Supabase Edge Function leads-ingest
# ============================================================
# Copie pra .env e preencha com valores reais — o .env está no .gitignore.
# Em produção (Hostinger), configure no painel: Node.js → Environment variables.
# NUNCA commitar credenciais reais neste arquivo.
#
# O front NUNCA chama o CRM direto. Ele faz POST pra /api/lead-consignacao no
# server.js, que faz o proxy pro leads-ingest com a x-api-key (só no servidor).

# Endpoint da Edge Function leads-ingest (igual pras duas LPs, carro e moto).
KCRM_ENDPOINT=https://zbjiqehakhntifmrvqay.supabase.co/functions/v1/leads-ingest

# API Key do CRM (header x-api-key). A origem ("Site") é FIXADA por esta chave —
# por isso cada LP deve ter sua própria key dedicada (não compartilhar a do carro).
# O que distingue a conversão é o tipo_conversao=consignacao_moto (hardcoded no
# server.js), não a key. NUNCA commite este valor. Rotacione se vazar.
KCRM_API_KEY=sua-api-key-de-motos-aqui

# ============================================================
# Servidor
# ============================================================

# Porta de escuta. Em Hostinger Passenger, deixar a plataforma decidir
# (env PORT é injetada). Em local, default 3000.
# PORT=3000
