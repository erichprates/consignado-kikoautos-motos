# ============================================================
# CRM RVops — credenciais e configuração
# ============================================================
# Como obter:
#   Painel RVops → Configurações → Integrações → API Tokens
# Em produção, nunca compartilhe as duas LPs (carro/moto) na MESMA
# API key — crie uma chave dedicada por deploy ("vendasuamoto-kikoautos-prod").

# Client ID do RVops — visível na URL do painel após login.
# É o mesmo ID das duas LPs (carro e moto) — só o lp_origem muda.
RVOPS_CLIENT_ID=seu-client-id-aqui

# API Key do RVops (Settings → API Keys).
# NUNCA commite esse valor. NUNCA loggue em response. Rotacione se vazar.
RVOPS_API_KEY=sua-api-key-aqui

# Identificador desta LP no RVops. Esta é a LP de venda/consignação
# de MOTO, servida em https://vendasuamoto.kikoautos.com.br.
# Cada deploy (carro, moto, etc.) tem seu próprio valor — nunca hardcode
# no código, sempre lido do env.
RVOPS_LP_ORIGEM=vendasuamoto-kikoautos

# ============================================================
# Servidor
# ============================================================

# Porta de escuta. Em Hostinger Passenger, deixar a plataforma decidir
# (env PORT é injetada). Em local, default 3000.
# PORT=3000
